# ICICI Direct Breeze API credentials (read-only - no order placing)
# You can use either ICICI_API_KEY or ICICI_APP_KEY
ICICI_API_KEY=your_app_key_here
ICICI_API_SECRET=your_secret_key_here
ICICI_SESSION_TOKEN=your_session_token_here

# Forecast settings
TARGET_SYMBOL=RELIANCE
FORECAST_HORIZON=30
NUM_SAMPLES=100

# App password for public deployment
APP_PASSWORD=choose_a_strong_password_here

# ---
# For Streamlit Community Cloud deployment:
# 1. Push this repo to GitHub (public)
# 2. Deploy at https://share.streamlit.io
# 3. Add these same keys in Streamlit Cloud > Settings > Secrets
# 4. Update ICICI_SESSION_TOKEN daily via Streamlit Cloud dashboard
# 5. Share APP_PASSWORD only with authorized users
# ---
